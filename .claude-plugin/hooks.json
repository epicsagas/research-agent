{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "command -v node >/dev/null 2>&1 && node \"${CLAUDE_PLUGIN_ROOT}/registry/scripts/install.js\" || exit 0",
            "async": false,
            "timeout": 300
          }
        ]
      }
    ]
  }
}
